void main(
    float2 texcoord : TEXCOORD0,
    uniform sampler2D framebufferTex : TEXUNIT0,
    uniform sampler2D overlayTex     : TEXUNIT1,
    out float4 color : COLOR
) {
    float4 base = tex2D(framebufferTex, texcoord);
    float4 over = tex2D(overlayTex,     texcoord);
    // Premultiplied blend: result = over + base*(1-over.a)
    color.rgb = over.rgb + base.rgb * (1.0 - over.a);
    color.a   = 1.0;
}